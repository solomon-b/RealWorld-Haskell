cabal-version: 3.4
name:          realworld-haskell
version:       0.1.0.0
synopsis:      RealWorld example app in Haskell
author:        solomon
maintainer:    ssbothwell@gmail.com
build-type:    Simple

common common-settings
  default-language:   GHC2021
  default-extensions:
    DerivingVia
    LambdaCase
    LinearTypes
    OverloadedStrings
    RecordWildCards

  ghc-options:
    -Wall -Wcpp-undef -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wpartial-fields
    -Werror=missing-home-modules

library
  import:          common-settings
  hs-source-dirs:  src
  exposed-modules:
    Phase1
    Phase1.Console
    Phase1.Lens
    Phase1.World
    Phase2
    Phase2.Lens
    Phase2.World
    Phase3
    Phase3.Console
    Phase3.Lens
    Phase3.Program
    Phase3.World
    Phase4
    Phase4.Console
    Phase4.Lens
    Phase4.Program
    Phase4.Wiring
    Phase4.World
    Phase5
    Phase5.Console
    Phase5.Lens
    Phase5.Program
    Phase5.Tree
    Phase5.Tree.Do
    Phase5.World

  build-depends:
    , base       >=4.18 && <5

executable realworld-haskell
  import:         common-settings
  hs-source-dirs: app
  main-is:        Main.hs
  build-depends:
    , base
    , realworld-haskell

test-suite realworld-haskell-test
  import:         common-settings
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  build-depends:
    , base
    , hedgehog
    , hspec
    , hspec-hedgehog
    , realworld-haskell
